          "+class TPInvariantPaiNNScalarFeedback(nn.Module):",
          "+    \"\"\"Scalar-only PaiNN-style invariant vector contraction feedback.",
          "+",
          "+    This is the proposal_002 ablation: vector channels are projected and",
          "+    contracted into invariant norm/dot features which can update scalar_state,",
          "+    while vector_state is returned unchanged (alpha_v = 0).  The final scalar",
          "+    outputs are zero-initialized and the residual cap is tiny, so the source",
          "+    generation_019/proposal_003 behavior is exactly recoverable at init.",
          "+    \"\"\"",
          "+",
          "+    def __init__(self, hidden_dim: int, residual_cap: float = 0.05, eps: float = 1e-8):",
          "+        super().__init__()",
          "+        self.hidden_dim = hidden_dim",
          "+        self.residual_cap = residual_cap",
          "+        self.eps = eps",
          "+",
          "+        # Bias-free channel projections mirror PaiNN's V/W vector mixing while",
          "+        # preserving the current [N, H, 3] vector layout.",
          "+        self.vector_v = nn.Linear(hidden_dim, hidden_dim, bias=False)",
          "+        self.vector_w = nn.Linear(hidden_dim, hidden_dim, bias=False)",
          "+        self.context_norm = nn.LayerNorm(hidden_dim * 2)",
          "+        self.scalar_context = nn.Sequential(",
          "+            nn.Linear(hidden_dim * 2, hidden_dim),",
          "+            nn.SiLU(),",
          "+            nn.Linear(hidden_dim, hidden_dim * 2),",
          "+        )",
          "+        self.scalar_residual_logit = nn.Parameter(torch.tensor(-6.0))",
          "+",
          "+        final = self.scalar_context[-1]",
          "+        nn.init.zeros_(final.weight)",
          "+        nn.init.zeros_(final.bias)",
          "+",
          "+    def _apply_linear_to_vector(self, linear: nn.Linear, vector: torch.Tensor) -> torch.Tensor:",
          "+        return linear(vector.transpose(1, 2)).transpose(1, 2)",
          "+",
          "+    def forward(self, scalar_state: torch.Tensor, vector_state: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:",
          "+        mu_v = self._apply_linear_to_vector(self.vector_v, vector_state)",
          "+        mu_w = self._apply_linear_to_vector(self.vector_w, vector_state)",
          "+",
          "+        vector_norm = torch.sqrt(torch.sum(mu_v * mu_v, dim=-1) + self.eps)",
          "+        vector_dot = torch.sum(mu_v * mu_w, dim=-1)",
          "+        context = self.context_norm(torch.cat([scalar_state, vector_norm], dim=-1))",
          "+        scalar_base, dot_gate = self.scalar_context(context).chunk(2, dim=-1)",
