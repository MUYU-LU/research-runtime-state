          "+        alpha_s = self.residual_cap * torch.sigmoid(self.scalar_residual_logit)",
          "+        scalar_delta = alpha_s * (scalar_base + dot_gate * vector_dot)",
          "+",
          "+        # Deliberate scalar-only ablation: alpha_v is fixed at zero.  Returning",
          "+        # the same vector_state object avoids adding any vector residual path.",
          "+        return scalar_state + scalar_delta, vector_state",
