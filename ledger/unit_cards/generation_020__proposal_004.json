          "+",
          "+class TPInvariantPaiNNMixing(nn.Module):",
          "+    \"\"\"Shared bounded PaiNN-style atomwise scalar/vector mixer.",
          "+",
          "+    The mixer contracts the current equivariant vector state into invariant",
          "+    norm/dot features, then feeds those invariants back into scalar channels",
          "+    and applies scalar-gated vector scaling.  It is deliberately source-",
          "+    recoverable: final context outputs start at exactly zero and residual",
          "+    coefficients are capped at 0.05, so disabling/zeroing the shared mixer",
          "+    recovers the source unit while allowing one recurrent rule to be reused",
          "+    after every TP residual merge.",
          "+    \"\"\"",
          "+",
          "+    def __init__(self, hidden_dim: int, mixer_dim: int | None = None, residual_cap: float = 0.05):",
          "+        super().__init__()",
          "+        self.hidden_dim = hidden_dim",
          "+        self.residual_cap = residual_cap",
          "+        mixer_dim = mixer_dim or max(hidden_dim // 2, 32)",
          "+",
          "+        self.vector_v = nn.Linear(hidden_dim, hidden_dim, bias=False)",
          "+        self.vector_w = nn.Linear(hidden_dim, hidden_dim, bias=False)",
          "+        self.context_net = nn.Sequential(",
          "+            nn.LayerNorm(hidden_dim * 2),",
          "+            nn.Linear(hidden_dim * 2, mixer_dim),",
          "+            nn.SiLU(),",
          "+            nn.Linear(mixer_dim, hidden_dim * 3),",
          "+        )",
          "+        self.scalar_residual_logit = nn.Parameter(torch.tensor(-6.0))",
          "+        self.vector_residual_logit = nn.Parameter(torch.tensor(-6.0))",
          "+        self.eps = 1e-8",
          "+",
          "+        # Exact zero-start residuals make generation_019/proposal_003",
          "+        # recoverable before learning opens the shared recurrent mixer.",
          "+        nn.init.zeros_(self.context_net[-1].weight)",
          "+        nn.init.zeros_(self.context_net[-1].bias)",
          "+",
          "+    def _apply_linear_to_vector(self, linear: nn.Linear, vector: torch.Tensor) -> torch.Tensor:",
          "+        return linear(vector.transpose(1, 2)).transpose(1, 2)",
          "+",
          "+    def residual_scales(self) -> tuple[torch.Tensor, torch.Tensor]:",
          "+        scalar_scale = self.residual_cap * torch.sigmoid(self.scalar_residual_logit)",
          "+        vector_scale = self.residual_cap * torch.sigmoid(self.vector_residual_logit)",
          "+        return scalar_scale, vector_scale",
          "+",
          "+    def forward(self, scalar_state: torch.Tensor, vector_state: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:",
          "+        mu_v = self._apply_linear_to_vector(self.vector_v, vector_state)",
          "+        mu_w = self._apply_linear_to_vector(self.vector_w, vector_state)",
          "+",
          "+        vector_norm = torch.sqrt(torch.sum(mu_v * mu_v, dim=-1) + self.eps)",
          "+        vector_dot = torch.sum(mu_v * mu_w, dim=-1)",
          "+        context = torch.cat([scalar_state, vector_norm], dim=-1)",
          "+        scalar_base, vector_gate, dot_gate = self.context_net(context).chunk(3, dim=-1)",
          "+",
          "+        # Scalar updates use only invariant contractions; vector updates are",
          "+        # scalar-gated linear vector combinations, preserving equivariance.",
          "+        scalar_delta = torch.tanh(scalar_base + dot_gate * torch.tanh(vector_dot))",
          "+        vector_delta = torch.tanh(vector_gate).unsqueeze(-1) * mu_w",
          "+        scalar_scale, vector_scale = self.residual_scales()",
          "+        return scalar_state + scalar_scale * scalar_delta, vector_state + vector_scale * vector_delta",
          " ",
          " ",
