          "+        device = scalar_state.device",
          "+",
          "+        edge_weight = cutoff_weight.unsqueeze(-1)",
          "+        weight_sum = torch.zeros(num_nodes, 1, device=device, dtype=dtype)",
          "+        weight_sum.index_add_(0, i_idx, edge_weight)",
