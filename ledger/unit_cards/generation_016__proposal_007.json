          "+        radial_channels: int = 6,",
          "+        type_dim: int = 4,",
          "+    ):",
          "+        super().__init__()",
          "+        self.radial_channels = radial_channels",
          "+        self.type_dim = type_dim",
          "+        self.out_dim = radial_channels * type_dim * 3",
          "+",
          "+        self.receiver_embedding = nn.Embedding(max_atomic_number + 1, type_dim)",
          "+        self.sender_embedding = nn.Embedding(max_atomic_number + 1, type_dim)",
          "+        self.type_mixer = nn.Sequential(",
          "+            nn.Linear(type_dim * 2, type_dim),",
          "+            nn.SiLU(),",
          "+            nn.Linear(type_dim, type_dim),",
          "+        )",
          "+        self.radial_projection = nn.Linear(num_rbf, radial_channels, bias=False)",
          "+",
          "+    def forward(",
          "+        self,",
          "+        numbers: torch.Tensor,",
          "+        i_idx: torch.Tensor,",
          "+        j_idx: torch.Tensor,",
          "+        unit: torch.Tensor,",
          "+        edge_basis: torch.Tensor,",
          "+        cutoff_weight: torch.Tensor,",
          "+    ) -> torch.Tensor:",
          "+        num_nodes = numbers.shape[0]",
          "+        if i_idx.numel() == 0:",
          "+            return edge_basis.new_zeros(num_nodes, self.out_dim)",
          "+",
          "+        x = unit[:, 0]",
          "+        y = unit[:, 1]",
          "+        z = unit[:, 2]",
          "+        angular = torch.stack(",
          "+            [",
          "+                torch.ones_like(x),",
          "+                x,",
          "+                y,",
          "+                z,",
          "+                x * x,",
          "+                y * y,",
          "+                z * z,",
          "+                x * y,",
          "+                x * z,",
          "+                y * z,",
          "+            ],",
