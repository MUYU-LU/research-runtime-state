          "+class TPInteractionBranch(nn.Module):",
          "+    \"\"\"Bounded l=0/l=1 tensor-product residual branch.",
          "+",
          "+    This is a deliberately small PyTorch-only NequIP-style probe.  It keeps the",
          "+    current scalar/vector state layout and computes only O(E*H) edge terms:",
          "+    scalar->scalar, dot(vector, unit)->scalar, and scalar*unit->vector.  The",
          "+    residual scale is initialized near zero so the source model is recovered at",
          "+    startup while gradients can still test whether explicit geometric coupling",
          "+    is useful.",
          "+    \"\"\"",
          "+",
          "+    def __init__(self, hidden_dim: int, num_rbf: int):",
          "+        super().__init__()",
          "+        self.edge_mlp = nn.Sequential(",
          "+            nn.Linear(num_rbf, hidden_dim),",
          "+            nn.SiLU(),",
          "+            nn.Linear(hidden_dim, hidden_dim * 3),",
          "+        )",
          "+        self.scalar_norm = nn.LayerNorm(hidden_dim)",
          "+        self.scalar_out = nn.Linear(hidden_dim, hidden_dim)",
          "+        self.vector_out = nn.Linear(hidden_dim, hidden_dim)",
          "+        self.residual_scale = nn.Parameter(torch.tensor(-6.0))",
          "+",
          "+        nn.init.normal_(self.scalar_out.weight, mean=0.0, std=1e-3)",
          "+        nn.init.zeros_(self.scalar_out.bias)",
          "+        nn.init.normal_(self.vector_out.weight, mean=0.0, std=1e-3)",
          "+        nn.init.zeros_(self.vector_out.bias)",
          "+",
          "+    def _apply_linear_to_vector(self, linear: nn.Linear, vector: torch.Tensor) -> torch.Tensor:",
          "+        return linear(vector.transpose(1, 2)).transpose(1, 2)",
          "+",
          "+    def forward(",
          "+        self,",
          "+        scalar_state: torch.Tensor,",
          "+        vector_state: torch.Tensor,",
          "+        i_idx: torch.Tensor,",
          "+        j_idx: torch.Tensor,",
          "+        unit: torch.Tensor,",
          "+        edge_basis: torch.Tensor,",
          "+        cutoff_weight: torch.Tensor,",
          "+    ) -> tuple[torch.Tensor, torch.Tensor]:",
          "+        edge_params = self.edge_mlp(edge_basis)",
          "+        scalar_to_scalar, vector_to_scalar, scalar_to_vector = edge_params.chunk(3, dim=-1)",
          "+",
          "+        cutoff = cutoff_weight.unsqueeze(-1)",
          "+        scalar_to_scalar = scalar_to_scalar * cutoff",
          "+        vector_to_scalar = vector_to_scalar * cutoff",
          "+        scalar_to_vector = scalar_to_vector * cutoff",
          "+",
          "+        src_scalar = scalar_state[j_idx]",
          "+        src_vector = vector_state[j_idx]",
          "+        vector_parallel = torch.sum(src_vector * unit.unsqueeze(1), dim=-1)",
          "+",
          "+        scalar_message = scalar_to_scalar * src_scalar + vector_to_scalar * vector_parallel",
          "+        vector_message = scalar_to_vector.unsqueeze(-1) * src_scalar.unsqueeze(-1) * unit.unsqueeze(1)",
          "+",
          "+        agg_scalar = torch.zeros_like(scalar_state)",
          "+        agg_vector = torch.zeros_like(vector_state)",
          "+        agg_scalar.index_add_(0, i_idx, scalar_message)",
          "+        agg_vector.index_add_(0, i_idx, vector_message)",
          "+",
          "+        num_nodes = scalar_state.shape[0]",
          "+        neighbor_count = torch.zeros(num_nodes, device=scalar_state.device, dtype=scalar_state.dtype)",
          "+        neighbor_count.index_add_(0, i_idx, torch.ones_like(i_idx, dtype=scalar_state.dtype))",
