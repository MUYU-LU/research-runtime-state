          " import torch",
          " from torch import nn",
          "+",
          "+",
          "+class StreamRefinementHelper(nn.Module):",
          "+    def __init__(self, hidden_dim: int, bottleneck_dim: int | None = None):",
          "+        super().__init__()",
          "+        self.hidden_dim = hidden_dim",
          "+        self.bottleneck_dim = bottleneck_dim or max(12, hidden_dim // 6)",
          "+        self.invariant_proj = nn.Sequential(",
          "+            nn.Linear(hidden_dim * 2, hidden_dim),",
          "+            nn.SiLU(),",
          "+            nn.Linear(hidden_dim, self.bottleneck_dim),",
          "+        )",
          "+        self.scalar_out = nn.Linear(self.bottleneck_dim, hidden_dim)",
          "+        self.vector_gate = nn.Linear(self.bottleneck_dim, hidden_dim)",
          "+        self.mix_gate = nn.Sequential(",
          "+            nn.Linear(hidden_dim * 2, hidden_dim),",
          "+            nn.SiLU(),",
          "+            nn.Linear(hidden_dim, hidden_dim),",
          "+        )",
          "+        self.scale = nn.Parameter(torch.tensor(0.15))",
          "+",
          "+    def forward(",
          "+        self,",
          "+        scalar_state: torch.Tensor,",
          "+        agg_scalar: torch.Tensor,",
          "+        self_vector: torch.Tensor,",
          "+        agg_vector: torch.Tensor,",
          "+    ) -> tuple[torch.Tensor, torch.Tensor]:",
          "+        agg_norm = torch.linalg.norm(agg_vector, dim=-1)",
          "+        cross_alignment = torch.sum(self_vector * agg_vector, dim=-1)",
          "+        invariant_feat = self.invariant_proj(torch.cat([agg_norm, cross_alignment], dim=-1))",
          "+",
          "+        scalar_delta = self.scalar_out(invariant_feat)",
          "+        vector_delta = torch.tanh(self.vector_gate(invariant_feat)).unsqueeze(-1) * agg_vector",
          "+        mix = torch.sigmoid(self.mix_gate(torch.cat([scalar_state, agg_scalar], dim=-1)))",
          "+        scale = 0.05 + 0.15 * torch.sigmoid(self.scale)",
          "+        return scale * mix * scalar_delta, scale * mix.unsqueeze(-1) * vector_delta",
          "+",
          "+",
          "+class CompactInvariantSummary(nn.Module):",
          "+    def __init__(self, hidden_dim: int, num_rbf: int, summary_dim: int | None = None):",
          "+        super().__init__()",
          "+        self.hidden_dim = hidden_dim",
          "+        self.summary_dim = summary_dim or max(12, hidden_dim // 8)",
          "+        self.edge_encoder = nn.Sequential(",
          "+            nn.Linear(num_rbf + 1, hidden_dim // 2),",
          "+            nn.SiLU(),",
          "+            nn.Linear(hidden_dim // 2, self.summary_dim),",
          "+        )",
          "+        self.triplet_proj = nn.Sequential(",
          "+            nn.Linear(self.summary_dim * 2 + 2, hidden_dim),",
          "+            nn.SiLU(),",
          "+            nn.Linear(hidden_dim, self.summary_dim),",
          "+            nn.Tanh(),",
          "+        )",
          "+        self.summary_norm = nn.LayerNorm(self.summary_dim)",
          "+        self.to_scalar = nn.Sequential(",
          "+            nn.Linear(self.summary_dim, hidden_dim),",
          "+            nn.SiLU(),",
          "+            nn.Linear(hidden_dim, hidden_dim),",
          "+        )",
          "+        self.to_readout = nn.Sequential(",
          "+            nn.Linear(self.summary_dim, hidden_dim // 2),",
          "+            nn.SiLU(),",
          "+            nn.Linear(hidden_dim // 2, self.summary_dim),",
          "+        )",
          "+        self.inject_gate = nn.Sequential(",
          "+            nn.Linear(hidden_dim * 2, hidden_dim),",
          "+            nn.SiLU(),",
          "+            nn.Linear(hidden_dim, hidden_dim),",
          "+        )",
          "+        self.scale = nn.Parameter(torch.tensor(0.1))",
          "+",
          "+    def forward(",
          "+        self,",
          "+        scalar_state: torch.Tensor,",
          "+        i_idx: torch.Tensor,",
          "+        unit: torch.Tensor,",
          "+        edge_basis: torch.Tensor,",
          "+        cutoff_weight: torch.Tensor,",
          "+    ) -> tuple[torch.Tensor, torch.Tensor]:",
          "+        num_nodes = scalar_state.shape[0]",
          "+        pair_feat = self.edge_encoder(torch.cat([edge_basis, cutoff_weight.unsqueeze(-1)], dim=-1))",
          "+        summary = scalar_state.new_zeros((num_nodes, self.summary_dim))",
          "+",
          "+        for center in range(num_nodes):",
          "+            center_edges = torch.where(i_idx == center)[0]",
          "+            if center_edges.numel() < 2:",
          "+                continue",
          "+",
          "+            center_pair = pair_feat[center_edges]",
          "+            center_unit = unit[center_edges]",
          "+            center_cutoff = cutoff_weight[center_edges]",
          "+            gram = center_unit @ center_unit.transpose(0, 1)",
          "+            lower = torch.tril_indices(center_edges.numel(), center_edges.numel(), offset=-1, device=i_idx.device)",
          "+            if lower.shape[1] == 0:",
          "+                continue",
          "+",
          "+            left = lower[0]",
          "+            right = lower[1]",
          "+            cos_angle = gram[left, right].unsqueeze(-1)",
          "+            pair_strength = (center_cutoff[left] * center_cutoff[right]).unsqueeze(-1)",
          "+            triplet_input = torch.cat([center_pair[left], center_pair[right], cos_angle, pair_strength], dim=-1)",
          "+            triplet_feat = self.triplet_proj(triplet_input)",
          "+            if triplet_feat.numel() > 0:",
          "+                summary[center] = triplet_feat.mean(dim=0)",
          "+",
          "+        summary = self.summary_norm(summary)",
          "+        injected = self.to_scalar(summary)",
          "+        gate = torch.sigmoid(self.inject_gate(torch.cat([scalar_state, injected], dim=-1)))",
          "+        scale = 0.04 + 0.12 * torch.sigmoid(self.scale)",
          "+        refined_scalar = scalar_state + scale * gate * injected",
          "+        return refined_scalar, self.to_readout(summary)",
          " "
        ]
