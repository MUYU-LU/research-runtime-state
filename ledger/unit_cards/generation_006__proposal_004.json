          "+class LateInvariantSummary(nn.Module):",
          "+    def __init__(self, hidden_dim: int, num_rbf: int, summary_dim: int | None = None):",
          "+        super().__init__()",
          "+        self.hidden_dim = hidden_dim",
          "+        self.summary_dim = summary_dim or max(12, hidden_dim // 6)",
          "+        self.edge_encoder = nn.Sequential(",
          "+            nn.Linear(num_rbf, hidden_dim // 2),",
          "+            nn.SiLU(),",
          "+            nn.Linear(hidden_dim // 2, self.summary_dim),",
          "+        )",
          "+        self.summary_norm = nn.LayerNorm(self.summary_dim * 2)",
          "+        self.to_scalar = nn.Sequential(",
          "+            nn.Linear(self.summary_dim * 2, hidden_dim),",
          "+            nn.SiLU(),",
          "+            nn.Linear(hidden_dim, hidden_dim),",
          "+        )",
          "+        self.scalar_gate = nn.Sequential(",
          "+            nn.Linear(hidden_dim * 2, hidden_dim),",
          "+            nn.SiLU(),",
          "+            nn.Linear(hidden_dim, hidden_dim),",
          "+        )",
          "+        self.summary_scale = nn.Parameter(torch.tensor(-1.2))",
          "+",
          "+    def forward(",
          "+        self,",
          "+        scalar_state: torch.Tensor,",
          "+        i_idx: torch.Tensor,",
          "+        unit: torch.Tensor,",
          "+        edge_basis: torch.Tensor,",
          "+        cutoff_weight: torch.Tensor,",
          "+    ) -> torch.Tensor:",
          "+        num_nodes = scalar_state.shape[0]",
          "+        encoded = self.edge_encoder(edge_basis) * cutoff_weight.unsqueeze(-1)",
          "+",
          "+        vector_accum = torch.zeros(",
          "+            num_nodes,",
          "+            self.summary_dim,",
          "+            3,",
          "+            device=scalar_state.device,",
          "+            dtype=scalar_state.dtype,",
          "+        )",
          "+        vector_accum.index_add_(0, i_idx, encoded.unsqueeze(-1) * unit.unsqueeze(1))",
          "+",
          "+        square_accum = torch.zeros(num_nodes, self.summary_dim, device=scalar_state.device, dtype=scalar_state.dtype)",
          "+        square_accum.index_add_(0, i_idx, encoded.square())",
          "+",
          "+        edge_accum = torch.zeros_like(square_accum)",
          "+        edge_accum.index_add_(0, i_idx, encoded)",
          "+",
          "+        neighbor_count = torch.zeros(num_nodes, device=scalar_state.device, dtype=scalar_state.dtype)",
          "+        neighbor_count.index_add_(0, i_idx, torch.ones_like(i_idx, dtype=scalar_state.dtype))",
          "+        inv_count = neighbor_count.clamp_min(1.0).reciprocal().unsqueeze(-1)",
          "+",
          "+        pair_summary = 0.5 * (torch.sum(vector_accum.square(), dim=-1) - square_accum)",
          "+        pair_summary = pair_summary * inv_count.square()",
          "+        edge_mean = edge_accum * inv_count",
