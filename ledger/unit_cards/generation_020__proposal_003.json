          "+",
          "+class TPInvariantPaiNNMixing(nn.Module):",
          "+    \"\"\"Late atomwise PaiNN-style invariant scalar/vector mixer.",
          "+",
          "+    The scalar path only consumes scalar features plus vector invariants",
          "+    (channel norms and vector-vector dot products), so energy channels remain",
          "+    rotation invariant.  The vector path is a scalar-gated linear vector",
          "+    residual.  Final projection weights are zero-initialized, making this an",
          "+    exact no-op at construction while leaving the bounded residual trainable.",
          "+    \"\"\"",
          "+",
          "+    def __init__(self, hidden_dim: int, eps: float = 1e-8):",
          "+        super().__init__()",
          "+        self.hidden_dim = hidden_dim",
          "+        self.eps = eps",
          "+        self.mu_v = nn.Linear(hidden_dim, hidden_dim, bias=False)",
          "+        self.mu_w = nn.Linear(hidden_dim, hidden_dim, bias=False)",
          "+        self.context_net = nn.Sequential(",
          "+            nn.Linear(hidden_dim * 2, hidden_dim),",
          "+            nn.SiLU(),",
          "+            nn.Linear(hidden_dim, hidden_dim * 3),",
          "+        )",
          "+        self.scalar_alpha_logit = nn.Parameter(torch.tensor(-6.0))",
          "+        self.vector_alpha_logit = nn.Parameter(torch.tensor(-7.0))",
          "+",
          "+        # Exact source fallback: scalar_delta, dot_gate, and vector_gate all",
          "+        # start at zero, so the mixer returns unchanged states at init.",
          "+        nn.init.zeros_(self.context_net[-1].weight)",
          "+        nn.init.zeros_(self.context_net[-1].bias)",
          "+",
          "+    def _apply_linear_to_vector(self, linear: nn.Linear, vector: torch.Tensor) -> torch.Tensor:",
          "+        return linear(vector.transpose(1, 2)).transpose(1, 2)",
          "+",
          "+    def residual_scales(self) -> tuple[torch.Tensor, torch.Tensor]:",
          "+        scalar_scale = 0.05 * torch.sigmoid(self.scalar_alpha_logit)",
          "+        vector_scale = 0.025 * torch.sigmoid(self.vector_alpha_logit)",
          "+        return scalar_scale, vector_scale",
          "+",
          "+    def forward(self, scalar_state: torch.Tensor, vector_state: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:",
          "+        mu_v = self._apply_linear_to_vector(self.mu_v, vector_state)",
          "+        mu_w = self._apply_linear_to_vector(self.mu_w, vector_state)",
          "+        vector_norm = torch.sqrt(torch.sum(mu_v * mu_v, dim=-1) + self.eps)",
          "+        vector_dot = torch.sum(mu_v * mu_w, dim=-1)",
          "+",
          "+        scalar_delta, vector_gate, dot_gate = self.context_net(",
          "+            torch.cat([scalar_state, vector_norm], dim=-1)",
          "+        ).chunk(3, dim=-1)",
          "+        scalar_update = scalar_delta + dot_gate * vector_dot",
          "+        vector_update = vector_gate.unsqueeze(-1) * mu_w",
          "+",
          "+        scalar_scale, vector_scale = self.residual_scales()",
          "+        return scalar_state + scalar_scale * scalar_update, vector_state + vector_scale * vector_update",
          " ",
