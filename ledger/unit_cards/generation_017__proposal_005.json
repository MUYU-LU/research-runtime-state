          "+",
          "+",
          "+class IntraatomicPainnMixing(nn.Module):",
          "+    \"\"\"One bounded PaiNN-style scalar/vector mixing update per atom.",
          "+",
          "+    This is intentionally local: it does not add edge loops or replace the",
          "+    existing interaction stack.  It forms rotationally invariant scalar",
          "+    contractions from the learned vector state, updates the scalar channels,",
          "+    and optionally nudges the vector channels through a gated residual.",
          "+    \"\"\"",
          "+",
          "+    def __init__(self, hidden_dim: int, eps: float = 1e-8):",
          "+        super().__init__()",
          "+        self.hidden_dim = hidden_dim",
          "+        self.eps = eps",
          "+",
          "+        self.u_proj = nn.Linear(hidden_dim, hidden_dim, bias=False)",
          "+        self.v_proj = nn.Linear(hidden_dim, hidden_dim, bias=False)",
          "+        self.w_proj = nn.Linear(hidden_dim, hidden_dim, bias=False)",
          "+        self.context_mlp = nn.Sequential(",
          "+            nn.LayerNorm(hidden_dim * 2),",
          "+            nn.Linear(hidden_dim * 2, hidden_dim),",
          "+            nn.SiLU(),",
          "+            nn.Linear(hidden_dim, hidden_dim * 3),",
          "+        )",
          "+        self.scalar_residual_scale = nn.Parameter(torch.tensor(-4.0))",
          "+        self.vector_residual_scale = nn.Parameter(torch.tensor(-4.0))",
          "+",
          "+        # Exact source fallback at initialization; the final layer learns the",
          "+        # PaiNN-like residual while preserving the inherited model at step 0.",
          "+        nn.init.zeros_(self.context_mlp[-1].weight)",
          "+        nn.init.zeros_(self.context_mlp[-1].bias)",
          "+",
          "+    def _apply_linear_to_vector(self, linear: nn.Linear, vector: torch.Tensor) -> torch.Tensor:",
          "+        return linear(vector.transpose(1, 2)).transpose(1, 2)",
          "+",
          "+    def forward(self, scalar_state: torch.Tensor, vector_state: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:",
          "+        u_vec = self._apply_linear_to_vector(self.u_proj, vector_state)",
          "+        v_vec = self._apply_linear_to_vector(self.v_proj, vector_state)",
          "+        w_vec = self._apply_linear_to_vector(self.w_proj, vector_state)",
          "+",
          "+        v_norm = torch.sqrt(torch.sum(v_vec * v_vec, dim=-1) + self.eps)",
          "+        uv_dot = torch.sum(u_vec * v_vec, dim=-1)",
          "+        context = torch.cat([scalar_state, v_norm], dim=-1)",
          "+        delta_scalar_base, delta_vector_gate, delta_scalar_dot = self.context_mlp(context).chunk(3, dim=-1)",
          "+",
          "+        scalar_scale = 0.1 * torch.sigmoid(self.scalar_residual_scale)",
          "+        vector_scale = 0.1 * torch.sigmoid(self.vector_residual_scale)",
          "+        delta_scalar = delta_scalar_base + delta_scalar_dot * uv_dot",
          "+",
          "+        mixed_scalar = scalar_state + scalar_scale * delta_scalar",
          "+        mixed_vector = vector_state + vector_scale * delta_vector_gate.unsqueeze(-1) * w_vec",
          "+        return mixed_scalar, mixed_vector",
          " ",
