          "+@dataclass",
          "+class CalibrationState:",
          "+    energy_scale: float = 1.0",
          "+    force_scale: float = 1.0",
          "+    momentum: float = 0.90",
          "+",
          "+    def normalize(self, loss_energy: torch.Tensor, loss_force: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:",
          "+        energy_scale = loss_energy.new_tensor(self.energy_scale).clamp_min(1e-6)",
          "+        force_scale = loss_force.new_tensor(self.force_scale).clamp_min(1e-6)",
          "+        normalized_energy = loss_energy / energy_scale",
          "+        normalized_force = loss_force / force_scale",
          "+        return normalized_energy, normalized_force",
          "+",
          "+    def update(self, loss_energy: torch.Tensor, loss_force: torch.Tensor) -> None:",
          "+        energy_value = float(loss_energy.detach().cpu().item())",
          "+        force_value = float(loss_force.detach().cpu().item())",
          "+        self.energy_scale = self.momentum * self.energy_scale + (1.0 - self.momentum) * max(energy_value, 1e-6)",
          "+        self.force_scale = self.momentum * self.force_scale + (1.0 - self.momentum) * max(force_value, 1e-6)",
          "+",
          "+",
          "+def _dataset_target_force_share(dataset: str) -> float:",
          "+    defaults = {",
          "+        \"rmd17\": 0.78,",
          "+        \"iso17\": 0.64,",
          "+    }",
          "+    return float(CONFIG.get(f\"{dataset}_target_force_share\", defaults.get(dataset, 0.7)))",
          "+",
          "+",
          "+def _compose_calibrated_loss(",
          "+    *,",
          "+    loss_energy: torch.Tensor,",
          "+    loss_force: torch.Tensor,",
          "+    energy_weight: float,",
          "+    force_weight: float,",
          "+    calibration_state: CalibrationState,",
          "+    target_force_share: float,",
          "+    calibration_strength: float,",
          "+    gap_strength: float,",
          "+) -> tuple[torch.Tensor, dict[str, float]]:",
          "+    normalized_energy, normalized_force = calibration_state.normalize(loss_energy, loss_force)",
          "+    weighted_energy = energy_weight * normalized_energy",
          "+    weighted_force = force_weight * normalized_force",
          "+    total = weighted_energy + weighted_force",
          "+",
          "+    force_share = weighted_force / total.detach().clamp_min(1e-6)",
          "+    calibration_penalty = torch.abs(force_share - target_force_share)",
          "+    gap_penalty = torch.abs(normalized_energy - normalized_force)",
          "+    loss = total + calibration_strength * calibration_penalty + gap_strength * gap_penalty",
          "+",
          "+    calibration_state.update(loss_energy, loss_force)",
