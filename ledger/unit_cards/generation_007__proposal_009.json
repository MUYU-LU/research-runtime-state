          "+        \"normalized_force\": float(normalized_force.detach().cpu().item()),",
          "+        \"force_share\": float(force_share.detach().cpu().item()),",
          "+        \"calibration_penalty\": float(calibration_penalty.detach().cpu().item()),",
          "+        \"gap_penalty\": float(gap_penalty.detach().cpu().item()),",
          "+    }",
