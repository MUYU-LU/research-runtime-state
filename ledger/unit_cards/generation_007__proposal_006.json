          "+class LateInvariantSummary(nn.Module):",
          "+    def __init__(self, hidden_dim: int, summary_dim: int | None = None):",
          "+        super().__init__()",
          "+        self.hidden_dim = hidden_dim",
          "+        self.summary_dim = summary_dim or max(12, hidden_dim // 8)",
          "+        self.invariant_proj = nn.Sequential(",
          "+            nn.Linear(hidden_dim * 3, hidden_dim),",
          "+            nn.SiLU(),",
          "+            nn.Linear(hidden_dim, self.summary_dim),",
          "+        )",
          "+        self.summary_norm = nn.LayerNorm(self.summary_dim)",
          "+        self.scalar_gate = nn.Sequential(",
          "+            nn.Linear(hidden_dim + self.summary_dim, hidden_dim),",
          "+            nn.SiLU(),",
          "+            nn.Linear(hidden_dim, hidden_dim),",
          "+        )",
          "+        self.scalar_update = nn.Linear(self.summary_dim, hidden_dim)",
          "+        self.inject_scale = nn.Parameter(torch.tensor(0.1))",
          "+",
          "+    def forward(self, scalar_state: torch.Tensor, vector_state: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:",
          "+        vector_norm = torch.linalg.norm(vector_state, dim=-1)",
          "+        squared_vector_norm = vector_norm.square()",
          "+        vector_mean = vector_state.mean(dim=-1)",
          "+        invariant_input = torch.cat([vector_norm, squared_vector_norm, vector_mean], dim=-1)",
          "+        summary = self.summary_norm(self.invariant_proj(invariant_input))",
          "+",
          "+        gate = torch.sigmoid(self.scalar_gate(torch.cat([scalar_state, summary], dim=-1)))",
          "+        scale = 0.04 + 0.12 * torch.sigmoid(self.inject_scale)",
          "+        refined_scalar = scalar_state + scale * gate * self.scalar_update(summary)",
          "+        return refined_scalar, summary",
