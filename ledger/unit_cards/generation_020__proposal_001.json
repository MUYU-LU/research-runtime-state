          "+class TPInvariantPaiNNMixing(nn.Module):",
          "+    \"\"\"Bounded PaiNN-style intraatomic scalar/vector mixer.",
          "+",
          "+    The current vector layout is [N, H, 3].  Bias-free channel projections",
          "+    produce PaiNN-like V/W vector features, invariant norm and dot contractions",
          "+    feed a scalar context MLP, and zero-initialized outputs plus small capped",
          "+    residual logits make the source unit exactly recoverable at initialization.",
          "+    \"\"\"",
          "+",
          "+    def __init__(self, hidden_dim: int, residual_cap: float = 0.05, eps: float = 1e-8):",
          "+        super().__init__()",
          "+        self.hidden_dim = hidden_dim",
          "+        self.residual_cap = residual_cap",
          "+        self.eps = eps",
          "+",
          "+        self.mu_v_proj = nn.Linear(hidden_dim, hidden_dim, bias=False)",
          "+        self.mu_w_proj = nn.Linear(hidden_dim, hidden_dim, bias=False)",
          "+        self.context_norm = nn.LayerNorm(hidden_dim * 2)",
          "+        self.context_mlp = nn.Sequential(",
          "+            nn.Linear(hidden_dim * 2, hidden_dim),",
          "+            nn.SiLU(),",
          "+            nn.Linear(hidden_dim, hidden_dim * 3),",
          "+        )",
          "+        self.scalar_residual_logit = nn.Parameter(torch.tensor(-6.0))",
          "+        self.vector_residual_logit = nn.Parameter(torch.tensor(-6.0))",
          "+",
          "+        # Exact source fallback at initialization.  The final layer can learn",
          "+        # immediately, while the hard cap keeps the new intra-layer path small.",
          "+        nn.init.zeros_(self.context_mlp[-1].weight)",
          "+        nn.init.zeros_(self.context_mlp[-1].bias)",
          "+",
          "+    def _apply_linear_to_vector(self, linear: nn.Linear, vector: torch.Tensor) -> torch.Tensor:",
          "+        return linear(vector.transpose(1, 2)).transpose(1, 2)",
          "+",
          "+    def residual_scales(self) -> tuple[torch.Tensor, torch.Tensor]:",
          "+        scalar_scale = self.residual_cap * torch.sigmoid(self.scalar_residual_logit)",
          "+        vector_scale = self.residual_cap * torch.sigmoid(self.vector_residual_logit)",
          "+        return scalar_scale, vector_scale",
          "+",
          "+    def forward(self, scalar_state: torch.Tensor, vector_state: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:",
          "+        mu_v = self._apply_linear_to_vector(self.mu_v_proj, vector_state)",
          "+        mu_w = self._apply_linear_to_vector(self.mu_w_proj, vector_state)",
          "+",
          "+        vector_norm = torch.sqrt(torch.sum(mu_v * mu_v, dim=-1) + self.eps)",
          "+        vector_dot = torch.sum(mu_v * mu_w, dim=-1)",
          "+        context = self.context_norm(torch.cat([scalar_state, vector_norm], dim=-1))",
          "+        scalar_delta, vector_gate, dot_gate = self.context_mlp(context).chunk(3, dim=-1)",
          "+",
          "+        scalar_scale, vector_scale = self.residual_scales()",
          "+        scalar_residual = scalar_delta + torch.tanh(dot_gate) * vector_dot",
          "+        vector_residual = torch.tanh(vector_gate).unsqueeze(-1) * mu_w",
          "+        return scalar_state + scalar_scale * scalar_residual, vector_state + vector_scale * vector_residual",
          " ",
