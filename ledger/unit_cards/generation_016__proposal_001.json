          "+class CartesianBodyOrderBranch(nn.Module):",
          "+    \"\"\"Small CACE-style A/B invariant branch used as a residual energy path.",
          "+",
          "+    The branch reuses the source neighbor list and RBF/cutoff values.  It builds",
          "+    edge features from projected radial channels, a tiny element-pair embedding,",
          "+    and Cartesian angular monomials, scatter-sums them to atom-centered A-basis",
          "+    tensors, then emits bounded nu=1/2 invariant summaries for an atomwise head.",
          "+    \"\"\"",
          "+",
          "+    def __init__(",
          "+        self,",
          "+        *,",
          "+        max_atomic_number: int,",
          "+        num_rbf: int,",
          "+        radial_channels: int = 6,",
          "+        type_channels: int = 4,",
          "+    ):",
          "+        super().__init__()",
          "+        self.radial_channels = radial_channels",
          "+        self.type_channels = type_channels",
          "+        self.angular = AngularMonomial()",
          "+        self.radial_proj = nn.Sequential(",
          "+            nn.Linear(num_rbf, radial_channels),",
          "+            nn.SiLU(),",
          "+        )",
          "+        self.receiver_type = nn.Embedding(max_atomic_number + 1, type_channels)",
          "+        self.sender_type = nn.Embedding(max_atomic_number + 1, type_channels)",
          "+        self.type_mix = nn.Sequential(",
          "+            nn.Linear(type_channels, type_channels),",
          "+            nn.SiLU(),",
          "+        )",
          "+        self.output_dim = radial_channels * type_channels * 4",
          "+",
          "+    def forward(",
          "+        self,",
          "+        numbers: torch.Tensor,",
          "+        i_idx: torch.Tensor,",
          "+        j_idx: torch.Tensor,",
          "+        unit: torch.Tensor,",
          "+        rbf: torch.Tensor,",
          "+        cutoff_weight: torch.Tensor,",
          "+        num_nodes: int,",
          "+    ) -> torch.Tensor:",
          "+        radial = self.radial_proj(rbf) * cutoff_weight.unsqueeze(-1)",
          "+        angular = self.angular(unit)",
          "+        type_basis = self.type_mix(self.receiver_type(numbers[i_idx]) + self.sender_type(numbers[j_idx]))",
          "+",
          "+        edge_features = radial[:, :, None, None] * angular[:, None, :, None] * type_basis[:, None, None, :]",
