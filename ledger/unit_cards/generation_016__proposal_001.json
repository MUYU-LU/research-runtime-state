          "+class AngularMonomial(nn.Module):",
          "+    \"\"\"Compact Cartesian monomials through l_max=2: 1, xyz, and symmetric quadratics.\"\"\"",
          "+",
          "+    def forward(self, unit: torch.Tensor) -> torch.Tensor:",
          "+        x = unit[:, 0]",
          "+        y = unit[:, 1]",
          "+        z = unit[:, 2]",
          "+        ones = torch.ones_like(x)",
          "+        return torch.stack(",
          "+            [",
          "+                ones,",
          "+                x,",
          "+                y,",
          "+                z,",
          "+                x * x,",
          "+                x * y,",
          "+                x * z,",
          "+                y * y,",
          "+                y * z,",
          "+                z * z,",
          "+            ],",
          "+            dim=-1,",
          "+        )",
          "+",
