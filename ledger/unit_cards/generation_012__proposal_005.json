          "+    except RuntimeError:",
          "+        return False",
          "+",
          "+    if not torch.isfinite(fitted).all():",
          "+        return False",
          "+",
          "+    with torch.no_grad():",
          "+        model.atomref.weight[observed.to(device), 0] = fitted.to(device=device, dtype=model.atomref.weight.dtype)",
          "+    return True",
