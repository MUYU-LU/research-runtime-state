          "+def initialize_atomref_lstsq(",
          "+    model: EvolutionMLIP,",
          "+    loader,",
          "+    *,",
          "+    ridge: float = 1e-3,",
          "+    device: torch.device,",
          "+) -> bool:",
          "+    \"\"\"Fit train-split per-element E0 values by regularized composition least squares.\"\"\"",
          "+    max_z = model.atomref.num_embeddings - 1",
          "+    rows = []",
          "+    targets = []",
          "+",
          "+    dataset_samples = getattr(getattr(loader, \"dataset\", None), \"samples\", None)",
          "+    batches = [dataset_samples] if dataset_samples is not None else loader",
          "+    for batch in batches:",
          "+        for sample in batch:",
          "+            numbers = sample[\"numbers\"].detach().cpu().long()",
          "+            energy = sample[\"energy\"].detach().cpu().reshape(())",
          "+            if numbers.numel() == 0 or not torch.isfinite(energy):",
          "+                continue",
          "+            counts = torch.bincount(numbers.clamp(min=0, max=max_z), minlength=max_z + 1).to(torch.float64)",
