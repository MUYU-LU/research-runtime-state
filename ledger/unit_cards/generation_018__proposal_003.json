          "+class LearnedSymmetricContraction(nn.Module):",
          "+    \"\"\"Bounded low-rank scalar product-basis contraction over atom_a.",
          "+",
          "+    The branch keeps the existing atom-centred Cartesian A tensor but replaces",
          "+    the previous fixed norm/A0 summary with learned low-rank channel/type",
          "+    projections.  Rotationally scalar outputs are formed with fixed l=0/l=1/l=2",
          "+    contractions, then an optional bounded correlation-3 block is concatenated.",
          "+    This gives a small MACE-style product basis without explicit triplets or any",
          "+    e3nn/MACE dependency.",
          "+    \"\"\"",
          "+",
          "+    def __init__(",
          "+        self,",
          "+        radial_dim: int,",
          "+        type_dim: int,",
          "+        num_angular: int,",
          "+        rank: int = 16,",
          "+        include_correlation3: bool = True,",
          "+    ):",
          "+        super().__init__()",
          "+        if num_angular != 10:",
          "+            raise ValueError(\"LearnedSymmetricContraction expects the current 10 Cartesian angular channels\")",
          "+        self.radial_dim = radial_dim",
          "+        self.type_dim = type_dim",
          "+        self.num_angular = num_angular",
          "+        self.rank = rank",
          "+        self.include_correlation3 = include_correlation3",
          "+        self.descriptor_dim = rank * 4 * (2 if include_correlation3 else 1)",
          "+",
          "+        self.input_norm = nn.LayerNorm(radial_dim * num_angular * type_dim)",
          "+        self.quadratic_weights = nn.Parameter(torch.empty(rank, radial_dim, type_dim))",
          "+        self.cubic_weights = nn.Parameter(torch.empty(rank, radial_dim, type_dim))",
          "+        self.output_mix = nn.Linear(self.descriptor_dim, self.descriptor_dim)",
          "+        self.output_norm = nn.LayerNorm(self.descriptor_dim)",
          "+        self.register_buffer(\"l2_metric\", torch.tensor([1.0, 1.0, 1.0, 2.0, 2.0, 2.0]))",
          "+        self.reset_parameters()",
          "+",
          "+    def reset_parameters(self) -> None:",
          "+        nn.init.normal_(self.quadratic_weights, mean=0.0, std=1.0 / math.sqrt(self.radial_dim * self.type_dim))",
          "+        nn.init.normal_(self.cubic_weights, mean=0.0, std=1.0 / math.sqrt(self.radial_dim * self.type_dim))",
          "+        nn.init.xavier_uniform_(self.output_mix.weight)",
          "+        nn.init.zeros_(self.output_mix.bias)",
          "+",
          "+    def _project(self, atom_a: torch.Tensor, weights: torch.Tensor) -> torch.Tensor:",
          "+        flat_weights = weights.flatten(start_dim=1)",
          "+        normalized_weights = torch.nn.functional.normalize(flat_weights, dim=-1).view_as(weights)",
          "+        return torch.einsum(\"nclt,rct->nrl\", atom_a, normalized_weights)",
          "+",
          "+    def _correlation2(self, projected: torch.Tensor) -> torch.Tensor:",
          "+        scalar_l0 = projected[:, :, 0]",
          "+        vector_norm = torch.sum(projected[:, :, 1:4] * projected[:, :, 1:4], dim=-1)",
          "+        tensor_l2 = projected[:, :, 4:10]",
          "+        tensor_norm = torch.sum(self.l2_metric.view(1, 1, 6) * tensor_l2 * tensor_l2, dim=-1)",
          "+        scalar_square = scalar_l0 * scalar_l0",
          "+        return torch.stack([scalar_l0, scalar_square, vector_norm, tensor_norm], dim=-1)",
          "+",
          "+    def _correlation3(self, projected: torch.Tensor) -> torch.Tensor:",
          "+        scalar_l0 = torch.tanh(projected[:, :, 0])",
          "+        vector_norm = torch.sum(projected[:, :, 1:4] * projected[:, :, 1:4], dim=-1)",
          "+        tensor_l2 = projected[:, :, 4:10]",
          "+        tensor_norm = torch.sum(self.l2_metric.view(1, 1, 6) * tensor_l2 * tensor_l2, dim=-1)",
          "+",
          "+        # Bound third-order magnitudes so this remains a residual descriptor,",
          "+        # not an uncontrolled high-order polynomial branch.",
          "+        vector_term = vector_norm / (1.0 + vector_norm)",
          "+        tensor_term = tensor_norm / (1.0 + tensor_norm)",
          "+        mixed_term = 0.5 * (vector_term + tensor_term)",
          "+        return torch.stack(",
          "+            [",
          "+                scalar_l0 * scalar_l0 * scalar_l0,",
          "+                scalar_l0 * vector_term,",
          "+                scalar_l0 * tensor_term,",
          "+                scalar_l0 * mixed_term,",
          "+            ],",
          "+            dim=-1,",
          "+        )",
          "+",
          "+    def forward(self, atom_a: torch.Tensor) -> torch.Tensor:",
          "+        normalized_a = self.input_norm(atom_a.flatten(start_dim=1)).view_as(atom_a)",
          "+        quadratic_projection = self._project(normalized_a, self.quadratic_weights)",
          "+        pieces = [self._correlation2(quadratic_projection).flatten(start_dim=1)]",
          "+        if self.include_correlation3:",
          "+            cubic_projection = self._project(normalized_a, self.cubic_weights)",
          "+            pieces.append(self._correlation3(cubic_projection).flatten(start_dim=1))",
          "+        descriptor = torch.cat(pieces, dim=-1)",
          "+        return self.output_norm(self.output_mix(descriptor))",
          "+",
