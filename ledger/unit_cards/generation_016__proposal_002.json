          "+class BodyOrderMessageBranch(nn.Module):",
          "+    \"\"\"Compact one-step invariant body-order descriptor message branch.",
          "+",
          "+    This is a bounded CACE-inspired side path: build atom-centered Cartesian",
          "+    A descriptors from the existing neighbor/RBF tensors, contract them into a",
          "+    small invariant B-like descriptor, apply one descriptor-level edge message,",
          "+    and return normalized per-atom features for a damped residual energy head.",
          "+    \"\"\"",
          "+",
          "+    def __init__(",
          "+        self,",
          "+        max_atomic_number: int,",
          "+        num_rbf: int,",
          "+        radial_dim: int = 8,",
          "+        type_dim: int = 4,",
          "+    ):",
          "+        super().__init__()",
          "+        self.radial_dim = radial_dim",
          "+        self.type_dim = type_dim",
          "+        self.num_angular = 10  # l=0 (1), l=1 (3), l=2 Cartesian monomials (6)",
          "+        self.descriptor_dim = radial_dim * type_dim * 4  # A_l0, |A_l1|^2, ||A_l2||^2, A_l0^2",
          "+",
          "+        self.radial_proj = nn.Linear(num_rbf, radial_dim)",
          "+        self.type_embedding = nn.Embedding(max_atomic_number + 1, type_dim)",
          "+        self.initial_norm = nn.LayerNorm(self.descriptor_dim)",
          "+",
          "+        self.edge_gate = nn.Sequential(",
          "+            nn.Linear(num_rbf, self.descriptor_dim),",
          "+            nn.Sigmoid(),",
          "+        )",
          "+        self.sender_message = nn.Sequential(",
          "+            nn.LayerNorm(self.descriptor_dim),",
          "+            nn.Linear(self.descriptor_dim, self.descriptor_dim),",
          "+            nn.SiLU(),",
          "+            nn.Linear(self.descriptor_dim, self.descriptor_dim),",
          "+        )",
          "+        self.message_norm = nn.LayerNorm(self.descriptor_dim)",
          "+",
          "+    def _angular_monomials(self, unit: torch.Tensor) -> torch.Tensor:",
          "+        x, y, z = unit.unbind(dim=-1)",
          "+        return torch.stack(",
          "+            [",
          "+                torch.ones_like(x),",
          "+                x,",
          "+                y,",
          "+                z,",
          "+                x * x,",
          "+                y * y,",
          "+                z * z,",
          "+                x * y,",
          "+                x * z,",
          "+                y * z,",
          "+            ],",
          "+            dim=-1,",
          "+        )",
          "+",
          "+    def _symmetrize(self, atom_a: torch.Tensor) -> torch.Tensor:",
          "+        a0 = atom_a[:, :, 0, :]",
          "+        a1 = atom_a[:, :, 1:4, :]",
          "+        a2 = atom_a[:, :, 4:10, :]",
          "+        l2_weights = atom_a.new_tensor([1.0, 1.0, 1.0, 2.0, 2.0, 2.0]).view(1, 1, 6, 1)",
          "+",
          "+        b0 = a0",
          "+        b1 = torch.sum(a1 * a1, dim=2)",
          "+        b2 = torch.sum(l2_weights * a2 * a2, dim=2)",
          "+        b0_sq = a0 * a0",
          "+        return torch.cat(",
          "+            [",
          "+                b0.flatten(start_dim=1),",
          "+                b1.flatten(start_dim=1),",
          "+                b2.flatten(start_dim=1),",
          "+                b0_sq.flatten(start_dim=1),",
          "+            ],",
          "+            dim=-1,",
          "+        )",
          "+",
          "+    def forward(",
          "+        self,",
          "+        numbers: torch.Tensor,",
          "+        i_idx: torch.Tensor,",
          "+        j_idx: torch.Tensor,",
          "+        unit: torch.Tensor,",
          "+        rbf: torch.Tensor,",
          "+        cutoff_weight: torch.Tensor,",
          "+    ) -> torch.Tensor:",
          "+        num_nodes = numbers.shape[0]",
          "+        radial = torch.nn.functional.silu(self.radial_proj(rbf)) * cutoff_weight.unsqueeze(-1)",
          "+        angular = self._angular_monomials(unit)",
          "+",
          "+        recv_type = self.type_embedding(numbers[i_idx])",
          "+        send_type = self.type_embedding(numbers[j_idx])",
          "+        pair_type = torch.tanh(recv_type + send_type)",
          "+",
          "+        edge_a = radial[:, :, None, None] * angular[:, None, :, None] * pair_type[:, None, None, :]",
          "+        atom_a = torch.zeros(",
          "+            num_nodes,",
          "+            self.radial_dim,",
          "+            self.num_angular,",
          "+            self.type_dim,",
          "+            device=rbf.device,",
          "+            dtype=rbf.dtype,",
          "+        )",
          "+        atom_a.index_add_(0, i_idx, edge_a)",
          "+",
          "+        neighbor_count = torch.zeros(num_nodes, device=rbf.device, dtype=rbf.dtype)",
          "+        neighbor_count.index_add_(0, i_idx, torch.ones_like(i_idx, dtype=rbf.dtype))",
          "+        atom_a = atom_a * neighbor_count.clamp_min(1.0).rsqrt().view(-1, 1, 1, 1)",
          "+",
          "+        descriptor = self.initial_norm(self._symmetrize(atom_a))",
          "+        edge_message = self.sender_message(descriptor[j_idx]) * self.edge_gate(rbf) * cutoff_weight.unsqueeze(-1)",
          "+        agg_message = torch.zeros_like(descriptor)",
          "+        agg_message.index_add_(0, i_idx, edge_message)"
